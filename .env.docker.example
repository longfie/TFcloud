# Copy this file to .env.docker or run scripts/docker-install.sh.
# The install script replaces all placeholder secrets automatically.
APP_PORT=8080

DB_NAME=tf_sign
DB_USER=tf_sign
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

APP_DEBUG=false
APP_KEY=base64:replace-with-32-byte-key
CREDENTIAL_KEY_VERSION=1
CREDENTIAL_FINGERPRINT_KEY=replace-with-independent-secret
LEGACY_PASSWORD_SALT=qq1790716272
CORS_ALLOWED_ORIGINS=http://localhost:8080
SESSION_SECURE=false

SIGN_WORKER_ENABLED=true
SIGN_WORKER_COUNT=1
TIEBA_RETRY_WORKER_ENABLED=true
TIEBA_RETRY_WORKER_COUNT=1
SIGN_SCHEDULER_ENABLED=true
MAIL_WORKER_ENABLED=true
TASK_LOCK_TIMEOUT_SECONDS=7200
MAINTENANCE_ENABLED=true
WEBMAN_WORKER_COUNT=4

UPDATE_VERSION_URL=https://raw.githubusercontent.com/longfie/TFcloud/main/backend/VERSION
UPDATE_PAGE_URL=https://github.com/longfie/TFcloud/releases
UPDATE_GITHUB_TOKEN=
